model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFile","Employees_Raw","DimDepartment","DimJobRole","DimEducation","DimDemographics","DimTravel","FactEmployee","DaxMeasures","OT Reduction Scenario"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table FactEmployee
ref table DimDepartment
ref table DimJobRole
ref table DimEducation
ref table DimDemographics
ref table DimTravel
ref table DaxMeasures
ref table 'OT Reduction Scenario'

ref cultureInfo en-US

